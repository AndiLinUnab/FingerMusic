logs/
*.log
*.tmp
*.bak

# Visual Studio Code: solo se comparten launch.json y settings.json
.vscode/*
!.vscode/launch.json
!.vscode/settings.json

# JetBrains / SO
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Capturas y videos personales (conserva la carpeta con .gitkeep)
screenshots/*
!screenshots/.gitkeep
