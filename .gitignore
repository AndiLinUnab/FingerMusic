# Entornos virtuales
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Pruebas y herramientas
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Secretos y configuración local
.env
.env.*
!.env.example

